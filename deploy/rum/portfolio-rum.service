# Метрики посетителей портфолио. Журнал — /var/lib/portfolio-rum/events.jsonl
[Unit]
Description=Portfolio RUM
After=network.target

[Service]
ExecStart=/usr/local/bin/portfolio-rum -addr 127.0.0.1:8090 -data /var/lib/portfolio-rum/events.jsonl
Restart=on-failure
# Свой временный пользователь и своя папка данных: сервису больше ничего не нужно
DynamicUser=yes
StateDirectory=portfolio-rum
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
